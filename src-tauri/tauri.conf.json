{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chinnu HealthAI",
  "version": "0.1.0",
  "identifier": "ai.chinnu.health",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Chinnu HealthAI", "width": 1280, "height": 820, "minWidth": 360, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
